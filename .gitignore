# 依赖与构建产物
# 注意：gitignore 不支持行尾注释，路径后的 # 会被当作字面量
node_modules/
# tsc 编译产物
build/
# docgen 生成的 HTML
dist/
*.tsbuildinfo

# 环境变量（切勿提交）
.env
.env.local
.env.*.local

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 临时探针目录
.scratch/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# 测试与覆盖率
coverage/
# docgen / 技能运行产物
output/

# 由 skills-lock.json 安装的技能（可重建，不入库）
.agents/skills/
