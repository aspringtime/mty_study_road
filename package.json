{
  "name": "docs-lab",
  "version": "0.1.0",
  "private": true,
  "description": "技术文档生成器：解析 content/ 下的 Markdown，产出 HTML 与目录树",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "docgen": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types test/slug.test.ts",
    "clean": "node -e \"import('node:fs').then(f=>{f.rmSync('dist',{recursive:true,force:true});f.rmSync('build',{recursive:true,force:true})})\""
  },
  "dependencies": {
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}